{
  "name": "@leather.io/mcp",
  "author": "Leather.io contact@leather.io",
  "description": "Local MCP server that lets AI agents read a paired Leather account and propose transactions",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --no-clean --watch",
    "format": "prettier . --write --ignore-path ../../.prettierignore",
    "format:check": "prettier . --check --ignore-path ../../.prettierignore",
    "lint": "eslint --cache --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "start": "node ./dist/index.js",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    "./bridge-client.js": "./dist/pages/bridge-client.js"
  },
  "bin": {
    "leather-mcp": "./dist/index.js"
  },
  "dependencies": {
    "@leather.io/constants": "workspace:*",
    "@leather.io/models": "workspace:*",
    "@leather.io/rpc": "workspace:*",
    "@leather.io/services": "workspace:*",
    "@leather.io/tokens": "workspace:*",
    "@leather.io/utils": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@stacks/transactions": "7.5.0",
    "@tanstack/query-core": "5.85.5",
    "bignumber.js": "9.1.2",
    "reflect-metadata": "0.2.2",
    "remeda": "2.21.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@leather.io/prettier-config": "workspace:*",
    "@leather.io/test-config": "workspace:*",
    "@leather.io/tsconfig-config": "workspace:*",
    "@types/node": "24.0.8",
    "prettier": "3.5.1",
    "tsdown": "0.16.5",
    "tslib": "2.6.2",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "files": [
    "dist"
  ],
  "prettier": "@leather.io/prettier-config",
  "private": true
}
